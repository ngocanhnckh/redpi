{
  "providers": {
    "synthetic": {
      "baseUrl": "https://api.synthetic.example/v1",
      "api": "openai-completions",
      "apiKey": "$SYNTHETIC_API_KEY",
      "models": [
        {
          "id": "synthetic-large",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 128000,
          "maxTokens": 8192,
          "cost": { "input": 1, "output": 5, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    },
    "gnu": {
      "baseUrl": "https://api.gnu.example/v1",
      "api": "openai-completions",
      "apiKey": "$GNU_API_KEY",
      "models": [
        { "id": "gnu-fast", "input": ["text"], "contextWindow": 64000, "maxTokens": 4096 }
      ]
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "api": "openai-completions",
      "apiKey": "$DEEPSEEK_API_KEY",
      "models": [
        {
          "id": "deepseek-chat",
          "input": ["text"],
          "reasoning": false,
          "contextWindow": 128000,
          "maxTokens": 8192,
          "compat": { "supportsDeveloperRole": false }
        }
      ]
    }
  }
}
